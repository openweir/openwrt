#!/bin/sh
case "$ACTION" in ifup|ifdown) ;;
 ifupdate) [ "${IFUPDATE_ADDRESSES:-}${IFUPDATE_ROUTES:-}${IFUPDATE_PREFIXES:-}${IFUPDATE_DATA:-}" != "" ] || exit 0 ;;
 *) exit 0 ;;
esac
[ -S /var/run/openweir/manager.sock ] || exit 0
case "$INTERFACE" in
 wan|wan6) ;;
 *) managed=$(uci -q get openweir.main.network) || exit 0
    case " $managed " in *" $INTERFACE "*) ;; *) exit 0 ;; esac ;;
esac
# Keep the attached-network bypass sets current (new IPv6 prefix, PPPoE redial) before the manager reacts.
/usr/libexec/openweir/network refresh >/dev/null 2>&1 || :
/usr/sbin/openweird notify-network
