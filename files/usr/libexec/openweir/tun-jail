#!/bin/sh
# openweird starts this helper in a new mount namespace. Only this core sees
# the private device node; the router's original device and mode stay intact.
# The core runs as root, so the node stays root's own.
set -eu
mine=$(readlink /proc/self/ns/mnt)
parent=$(readlink "/proc/$PPID/ns/mnt")
[ -n "$mine" ] && [ -n "$parent" ] && [ "$mine" != "$parent" ] || exit 1
[ -c /dev/net/tun ] && [ "$(cat /sys/class/misc/tun/dev)" = 10:200 ] || exit 1
mount --make-rprivate /
mount -t tmpfs -o mode=0755,nosuid,noexec,size=16k openweir-tun /dev/net
mknod -m 0600 /dev/net/tun c 10 200
exec /sbin/ujail "$@"
